# ==============================================================================
# 三服务部署包 .env 配置模板（由 gen_deploy.py 生成，请勿手工增删变量）
# 用法：cp .env.example .env 后按单位实际环境修改取值
# 约束：变量集与 docker-compose.yml 的 ${VAR:-默认} 引用集双向一致（validate.py C3）
# 安全：全部为占位默认值，无真实凭据；凭据类变量一律经 ${} 引用（validate.py C4）
# ==============================================================================

# -------- asr 语音识别（宿主端口 8001，容器内统一 8000） --------
ASR_IMAGE=placeholder/asr:dev
ASR_PORT=8001
ASR_INPUT_DIR=./data/asr-in
ASR_OUTPUT_DIR=./data/asr-out
ASR_MODEL=base

# -------- minutes 会议纪要（宿主端口 8002，容器内统一 8000） --------
# 管线接线：MINUTES_INPUT_DIR 必须与 asr.ASR_OUTPUT_DIR 同值（默认 ./data/asr-out）
MINUTES_IMAGE=placeholder/minutes:dev
MINUTES_PORT=8002
MINUTES_INPUT_DIR=./data/asr-out
MINUTES_OUTPUT_DIR=./data/minutes-out

# -------- todo 待办清单（宿主端口 8003，容器内统一 8000） --------
TODO_IMAGE=placeholder/todo:dev
TODO_PORT=8003
TODO_DATA_DIR=./data/todo

# ------------------------------------------------------------------------------
# 单位落地提示：
# 1) 镜像均为占位（placeholder/*），落地时替换为单位镜像仓库地址并同步修改 .env；
# 2) 数据目录默认相对部署目录（./data/...），按单位磁盘规划调整并确保可写；
# 3) 宿主端口冲突时调整 *_PORT，容器内端口固定 8000 勿动；
# 4) 健康检查路径 /healthz，启动后按 DEPLOY.md 逐服务 curl 验收；
# 5) 如需裁剪服务子集，用 gen_deploy.py --services 重新生成整包，勿手工删块。
# ------------------------------------------------------------------------------
