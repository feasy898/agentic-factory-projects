# ==========================================================
# deploy-pack 环境变量示例 — 由 gen_deploy.py 自动生成
# 用法: cp .env.example .env 后按需修改；docker compose 自动读取同目录 .env
# 安全: 本文件全部为占位/示例值，不含任何真实凭据；.env 请勿提交版本库
# ==========================================================

# ---- asr（语音识别）----
# asr 服务镜像（占位名，上线前替换为真实镜像）
ASR_IMAGE=placeholder/asr:dev
# asr 宿主机端口
ASR_PORT=8001
# asr 输入目录（上传音频落盘处）
ASR_INPUT_DIR=./data/incoming
# asr 输出目录（转写结果落盘处；即 minutes 的输入目录）
ASR_OUTPUT_DIR=./data/asr-out
# asr 模型档位（占位示例）
ASR_MODEL=base

# ---- minutes（会议纪要）----
# minutes 服务镜像（占位名，上线前替换为真实镜像）
MINUTES_IMAGE=placeholder/minutes:dev
# minutes 宿主机端口
MINUTES_PORT=8002
# minutes 输入目录（必须与 asr 的 ASR_OUTPUT_DIR 同一路径——管线接线）
MINUTES_INPUT_DIR=./data/asr-out
# minutes 输出目录（纪要落盘处）
MINUTES_OUTPUT_DIR=./data/minutes-out
