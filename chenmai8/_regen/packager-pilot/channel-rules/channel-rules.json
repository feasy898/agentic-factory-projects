{
  "rulesVersion": "2026.09.0",
  "channels": {
    "applovin": {
      "package": { "format": "single-html" },
      "maxBytes": 5242880,
      "maxFiles": 8,
      "exit": { "protocol": "mraid", "call": "mraid.open()" },
      "runtime": { "muteBeforeFirstInteraction": true, "injectRelativeScripts": ["mraid.js"] }
    },
    "meta": {
      "package": { "format": "single-html" },
      "maxBytes": 5242880,
      "maxFiles": 8,
      "exit": { "protocol": "url", "call": "window.location.assign(url)" },
      "runtime": { "muteBeforeFirstInteraction": true, "forbidMraid": true }
    },
    "mintegral": {
      "package": { "format": "zip", "entry": "Template.html", "structure": ["build.js", "Template.html"] },
      "maxBytes": 5242880,
      "maxFiles": 8,
      "exit": { "protocol": "url", "call": "window.location.assign(url)" },
      "runtime": { "muteBeforeFirstInteraction": true }
    }
  }
}
