<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="{{ lang }}">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ ui["passport.title"] }} · {{ meta["report_id"] }}</title>
<style>
:root {
  --ink: #2b2118; --muted: #7a6a58; --line: #e5d9c6; --paper: #fffdf9;
  --accent: #6f4a1f; --accent2: #a9713a; --ok: #1d7a3d; --bad: #b3261e;
  --ok-bg: #e8f5ec; --bad-bg: #fbeae9; --warn-bg: #fff4d6; --warn-ink: #8a6400;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: #f4efe7; color: var(--ink);
  font-family: "Microsoft YaHei", "SimHei", "PingFang SC", "Segoe UI", Arial, sans-serif;
  font-size: 13px; line-height: 1.45;
}
.page { max-width: 820px; margin: 0 auto; padding: 26px 30px 34px; background: var(--paper); }
h1 { font-size: 24px; margin: 2px 0 2px; letter-spacing: 1px; }
h2 {
  font-size: 15px; margin: 26px 0 8px; padding: 3px 10px; color: #fff;
  background: var(--accent); border-radius: 3px; letter-spacing: 1px;
}
h3 { font-size: 13px; margin: 12px 0 4px; color: var(--accent); }
.brand { font-size: 12px; font-weight: 700; color: var(--accent2); letter-spacing: 2px; }
.subtitle { color: var(--muted); font-size: 12px; margin-bottom: 10px; }
table { border-collapse: collapse; width: 100%; margin: 6px 0; }
th, td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
th { background: #f6efe2; font-weight: 600; white-space: nowrap; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.kv th { width: 19%; }
code { font-family: Consolas, Menlo, monospace; font-size: 11px; background: #f6f1e8; padding: 0 3px; border-radius: 2px; }
code.sha, code.payload { word-break: break-all; }
.muted { color: var(--muted); font-size: 12px; }
.grade-box {
  display: flex; align-items: center; gap: 16px; padding: 12px 16px; margin: 8px 0;
  border-radius: 6px; border: 1px solid var(--line);
}
.grade-box.pass { background: var(--ok-bg); border-color: #bfe3cb; }
.grade-box.fail { background: var(--bad-bg); border-color: #efc4c1; }
.grade-badge {
  font-size: 20px; font-weight: 800; padding: 4px 14px; border-radius: 4px;
  letter-spacing: 2px; color: #fff;
}
.grade-box.pass .grade-badge { background: var(--ok); }
.grade-box.fail .grade-badge { background: var(--bad); }
.grade-value { font-size: 30px; font-weight: 800; letter-spacing: 1px; }
.reasons ul { margin: 4px 0 0 18px; padding: 0; }
.cards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.card { border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; background: #fff; }
.card-head { display: flex; align-items: baseline; gap: 8px; border-bottom: 1px dashed var(--line); padding-bottom: 4px; }
.bean-id { font-weight: 800; font-size: 14px; }
.defect-name { color: var(--bad); font-weight: 700; }
.chip {
  margin-left: auto; font-size: 11px; padding: 1px 8px; border-radius: 10px;
  background: #f1e7d8; color: var(--accent); white-space: nowrap;
}
.imgs { display: flex; gap: 8px; margin: 8px 0 4px; flex-wrap: wrap; }
figure.side { margin: 0; flex: 1 1 45%; min-width: 150px; }
figure.side img {
  width: 100%; height: auto; display: block; border: 1px solid var(--line); border-radius: 4px; background: #eee;
}
figure.side.winner img { border: 2px solid var(--accent2); }
figure.side figcaption { font-size: 11px; color: var(--muted); margin-top: 2px; }
.side-label { font-weight: 700; color: var(--ink); margin-right: 6px; }
.ph-tag { display: block; color: var(--warn-ink); }
.card-kv { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; margin: 4px 0 0; font-size: 12px; }
.card-kv dt { color: var(--muted); }
.card-kv dd { margin: 0; }
img.chart { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; background: #fff; }
table.stats td { text-align: right; font-variant-numeric: tabular-nums; }
.qr-box { display: flex; gap: 14px; align-items: flex-start; margin-top: 14px; }
img.qr { width: 110px; height: 110px; border: 1px solid var(--line); border-radius: 4px; }
.qr-caption { font-weight: 700; margin-bottom: 4px; }
.qr-text .kv-line { margin: 3px 0; font-size: 11px; color: var(--muted); }
.badges { margin-top: 12px; }
.badge { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 10px; border-radius: 10px; margin-right: 8px; }
.badge.ok { background: var(--ok-bg); color: var(--ok); }
.badge.warn { background: var(--warn-bg); color: var(--warn-ink); }
.foot-note { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; }
@media print {
  body { background: #fff; font-size: 10.5pt; }
  .page { max-width: none; padding: 0; }
  section, .card { break-inside: avoid; page-break-inside: avoid; }
}
@page { size: A4; margin: 12mm; }
</style>
</head>
<body>
<div class="page">
  <header>
    <div class="brand">{{ ui["passport.brand"] }}</div>
    <h1>{{ ui["passport.title"] }}</h1>
    <div class="subtitle">{{ ui["passport.subtitle"] }}</div>
    <table class="meta">
      <tr>
        <th>{{ ui["meta.report_id"] }}</th><td><code>{{ meta["report_id"] }}</code></td>
        <th>{{ ui["meta.sample_id"] }}</th><td>{{ meta["sample_id"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["meta.scan_ids"] }}</th><td>{{ meta["scan_ids"] }}</td>
        <th>{{ ui["meta.generated_at"] }}</th><td>{{ meta["generated_at"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["meta.standard"] }}</th><td colspan="3">{{ standard_display }} <code>{{ meta["standard_id"] }}</code></td>
      </tr>
    </table>
  </header>

  <section id="grading">
    <h2>{{ ui["grading.title"] }}</h2>
    <div class="grade-box {{ "pass" if grade["passed"] else "fail" }}">
      <span class="grade-badge">{{ grade["result_label"] }}</span>
      <span class="grade-value">{{ grade["grade"] }}</span>
    </div>
    <table class="kv">
      <tr>
        <th>{{ ui["grading.primary_count"] }}</th><td>{{ grade["primary_count"] }}</td>
        <th>{{ ui["grading.secondary_count"] }}</th><td>{{ grade["secondary_count"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["grading.standard_sha"] }}</th><td colspan="3"><code class="sha">{{ grade["standard_sha"] }}</code></td>
      </tr>
    </table>
    {% if grade["reasons"] %}
    <h3>{{ ui["grading.reasons"] }}</h3>
    <div class="reasons">
      <ul>
        {% for r in grade["reasons"] %}
        <li>{{ r }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>

  <section id="defects">
    <h2>{{ ui["defects.title"] }}</h2>
    {% if defects["rows"] %}
    <table>
      <tr>
        <th>{{ ui["defects.col.defect"] }}</th>
        <th>{{ ui["defects.col.kind"] }}</th>
        <th class="num">{{ ui["defects.col.count"] }}</th>
        <th class="num">{{ ui["defects.col.share"] }}</th>
      </tr>
      {% for r in defects["rows"] %}
      <tr>
        <td>{{ r["name"] }} <code>{{ r["key"] }}</code></td>
        <td>{{ r["kind"] }}</td>
        <td class="num">{{ r["count"] }}</td>
        <td class="num">{{ r["share"] }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}
    <table class="kv">
      <tr>
        <th>{{ ui["defects.bean_count"] }}</th><td>{{ defects["bean_count"] }}</td>
        <th>{{ ui["defects.defective_count"] }}</th><td>{{ defects["defective_count"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["defects.defect_rate"] }}</th><td>{{ defects["defect_rate"] }}</td>
        <td colspan="2"></td>
      </tr>
    </table>
  </section>

  <section id="metrology">
    <h2>{{ ui["metrology.title"] }}</h2>
    <img class="chart" src="{{ metro["chart_uri"] }}" alt="{{ ui["metrology.sieve_hist"] }}"/>
    <table>
      <tr>
        <th>{{ ui["metrology.col.sieve"] }}</th>
        <th class="num">{{ ui["metrology.col.count"] }}</th>
        <th class="num">{{ ui["metrology.col.share"] }}</th>
      </tr>
      {% for r in metro["sieve_rows"] %}
      <tr>
        <td>{{ r["sieve"] }}</td>
        <td class="num">{{ r["count"] }}</td>
        <td class="num">{{ r["share"] }}</td>
      </tr>
      {% endfor %}
    </table>
    <table class="kv">
      <tr>
        <th>{{ ui["metrology.bean_count"] }}</th><td>{{ defects["bean_count"] }}</td>
        <th>{{ ui["metrology.sieve_pass"] }}</th><td>{{ metro["sieve_pass"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["metrology.est_weight"] }}</th><td>{{ metro["weight"] }} <span class="muted">{{ metro["weight_model"] }}</span></td>
        <th>{{ ui["metrology.delta_e"] }}</th><td>{{ metro["delta_e"] }}</td>
      </tr>
      <tr>
        <th>{{ ui["metrology.color_mean"] }}</th><td>{{ metro["color"] }}</td>
        <td colspan="2"></td>
      </tr>
    </table>
    <h3>{{ ui["metrology.diameter_stats"] }}</h3>
    <table class="stats">
      <tr>
        <th>{{ ui["stats.min"] }}</th><th>{{ ui["stats.max"] }}</th>
        <th>{{ ui["stats.mean"] }}</th><th>{{ ui["stats.median"] }}</th>
      </tr>
      <tr>
        <td>{{ metro["diam"]["min"] }}</td><td>{{ metro["diam"]["max"] }}</td>
        <td>{{ metro["diam"]["mean"] }}</td><td>{{ metro["diam"]["median"] }}</td>
      </tr>
    </table>
    {% if metro["de_rows"] %}
    <h3>{{ ui["metrology.delta_e_hist"] }}</h3>
    <table>
      <tr><th>{{ ui["metrology.delta_e"] }}</th>
        {% for r in metro["de_rows"] %}
        <th class="num">{{ r["bucket"] }}</th>
        {% endfor %}
      </tr>
      <tr><th>{{ ui["metrology.col.count"] }}</th>
        {% for r in metro["de_rows"] %}
        <td class="num">{{ r["count"] }}</td>
        {% endfor %}
      </tr>
    </table>
    {% endif %}
  </section>

  <section id="evidence">
    <h2>{{ ui["evidence.title"] }}</h2>
    <p class="muted">{{ evidence_line }}</p>
    {% if not cards %}
    <p>{{ ui["evidence.none"] }}</p>
    {% endif %}
    <div class="cards">
      {% for c in cards %}
      <article class="card" data-bean-id="{{ c["bean_id"] }}" data-defect="{{ c["defect_key"] }}">
        <header class="card-head">
          <span class="bean-id">{{ c["bean_id"] }}</span>
          <span class="defect-name">{{ c["defect_name"] }}</span>
          <span class="chip">{{ c["worst_label"] }}</span>
        </header>
        <div class="imgs">
          {% for s in c["sides"] %}
          <figure class="side {{ "winner" if s["is_winner"] else "" }}">
            <img src="{{ s["img_uri"] }}" alt="{{ c["bean_id"] }} {{ s["label"] }}" width="160" height="120"/>
            <figcaption>
              <span class="side-label">{{ s["label"] }}{% if s["is_winner"] %} ★{% endif %}</span>
              <span>{{ s["conf"] }}</span>
              {% if s["placeholder"] %}
              <span class="ph-tag">{{ ui["evidence.img.placeholder"] }}</span>
              {% endif %}
              <span class="side-coord">{{ s["coord"] }}</span>
              <span> · {{ s["diam"] }}</span>
            </figcaption>
          </figure>
          {% endfor %}
        </div>
        <dl class="card-kv">
          <dt>{{ ui["evidence.bean"] }}</dt><dd><code>{{ c["bean_id"] }}</code></dd>
          <dt>{{ ui["evidence.defect"] }}</dt><dd>{{ c["defect_name"] }} <code>{{ c["defect_key"] }}</code></dd>
          <dt>{{ ui["evidence.conf"] }}</dt><dd>{{ c["conf"] }}</dd>
          <dt>{{ ui["evidence.severity"] }}</dt><dd>{{ c["rank"] }}</dd>
        </dl>
      </article>
      {% endfor %}
    </div>
  </section>

  <section id="agent">
    <h2>{{ ui["agent.title"] }}</h2>
    {% if agent %}
    <table>
      <tr>
        <th>{{ ui["evidence.defect"] }} · {{ ui["agent.stage"] }}</th>
        <th class="num">{{ ui["agent.likelihood"] }}</th>
        <th>{{ ui["agent.evidence"] }}</th>
      </tr>
      {% for c in agent["causes"] %}
      <tr>
        <td>{{ c["defect"] }} · {{ c["stage"] }}</td>
        <td class="num">{{ c["likelihood"] }}</td>
        <td>{{ c["evidence"] }}</td>
      </tr>
      {% endfor %}
    </table>
    <h3>{{ ui["agent.advice"] }}</h3>
    <ul>
      {% for a in agent["advice"] %}
      <li>{{ a }}</li>
      {% endfor %}
    </ul>
    <p class="muted">
      {{ ui["agent.citations"] }}:
      {% for x in agent["citations"] %}
      <code>{{ x }}</code>
      {% endfor %}
      · {{ ui["agent.backend"] }}: {{ agent["backend"] }}
    </p>
    {% else %}
    <p class="muted">{{ ui["agent.none"] }}</p>
    {% endif %}
  </section>

  <footer class="pass-foot">
    <div class="qr-box">
      <img class="qr" src="{{ qr_uri }}" alt="QR {{ meta["report_id"] }}" width="110" height="110"/>
      <div class="qr-text">
        <div class="qr-caption">{{ ui["qr.caption"] }}</div>
        <div class="kv-line">{{ ui["qr.payload"] }}: <code class="payload">{{ payload }}</code></div>
        <div class="kv-line">{{ ui["qr.sha256"] }}: <code class="sha">{{ sha }}</code></div>
      </div>
    </div>
    <div class="badges">
      {% if standard_verified is not none %}
      {% if standard_verified %}
      <span class="badge ok">{{ ui["footer.standard_verified"] }}</span>
      {% else %}
      <span class="badge warn">{{ ui["footer.standard_unverified"] }}</span>
      {% endif %}
      {% endif %}
    </div>
    <div class="foot-note muted">{{ ui["footer.note"] }} {{ ui["passport.brand"] }} · {{ meta["generated_at"] }}</div>
  </footer>
</div>
</body>
</html>
