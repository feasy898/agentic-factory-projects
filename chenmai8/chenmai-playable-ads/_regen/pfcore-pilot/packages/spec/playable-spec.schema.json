{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pf:spec:playable-spec:1.0.0",
  "title": "PlayableSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "meta", "game", "flow", "assets", "i18n", "channels", "qc"],
  "properties": {
    "specVersion": { "const": "1.0.0" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "seed"],
      "properties": {
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "title": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": { "enum": ["match3", "merge", "pullpin", "sort"] },
        "params": { "type": "object" },
        "difficulty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetLevel": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
          }
        },
        "attract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nearWin": { "type": "boolean", "default": false },
            "failBait": { "type": "boolean", "default": false },
            "firstClickSucceed": { "type": "boolean", "default": true }
          }
        },
        "durationBudgetSec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "max"],
          "properties": {
            "target": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0, "maximum": 30 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "template": { "const": "match3" } }, "required": ["template"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/match3Params" } } }
        },
        {
          "if": { "properties": { "template": { "const": "merge" } }, "required": ["template"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/mergeParams" } } }
        },
        {
          "if": { "properties": { "template": { "const": "pullpin" } }, "required": ["template"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/pullpinParams" } } }
        },
        {
          "if": { "properties": { "template": { "const": "sort" } }, "required": ["template"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/sortParams" } } }
        }
      ]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endScreen"],
      "properties": {
        "tutorial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "gesture": { "enum": ["tap", "drag"], "default": "drag" },
            "maxSec": { "type": "number", "minimum": 0, "default": 3 }
          }
        },
        "endScreen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landingUrl"],
          "properties": {
            "showScore": { "type": "boolean", "default": true },
            "ctaKey": { "type": "string", "default": "cta" },
            "landingUrl": { "type": "string", "pattern": "^https?://\\S+$", "maxLength": 512 }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": ["string", "null"] },
        "sprites": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "audio": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "fontSubset": { "type": ["string", "null"] }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "locales", "strings"],
      "properties": {
        "defaultLocale": { "type": "string", "minLength": 1 },
        "locales": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "strings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/localeStrings" }
        },
        "rtl": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "uniqueItems": true
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "items": { "enum": ["applovin", "meta", "mintegral", "unity", "google", "tiktok"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "orientation": { "type": "string" },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxBytes": { "type": "number", "minimum": 0 },
              "ctaStyle": { "type": "string" }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer", "minimum": 0 },
          "palette": { "type": "string" }
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLoadSec": { "type": "number", "minimum": 0.5, "maximum": 10, "default": 2.0 },
        "autoplayTimeoutSec": { "type": "number", "minimum": 5, "maximum": 120, "default": 45 }
      }
    }
  },
  "$defs": {
    "localeStrings": {
      "type": "object",
      "required": ["cta", "tutorial", "win", "lose", "score"],
      "additionalProperties": true,
      "properties": {
        "cta": { "type": "string" },
        "tutorial": { "type": "string" },
        "win": { "type": "string" },
        "lose": { "type": "string" },
        "score": { "type": "string" }
      }
    },
    "match3Params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cols": { "type": "integer", "minimum": 4, "maximum": 9, "default": 6 },
        "rows": { "type": "integer", "minimum": 4, "maximum": 9, "default": 6 },
        "moves": { "type": "integer", "minimum": 3, "maximum": 60, "default": 15 },
        "colors": { "type": "integer", "minimum": 3, "maximum": 5, "default": 5 },
        "goalType": { "enum": ["clear-jelly", "score"], "default": "clear-jelly" },
        "goalCount": { "type": "integer", "minimum": 1, "maximum": 999, "default": 30 },
        "spriteKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 5,
          "maxItems": 5,
          "default": ["piece-0", "piece-1", "piece-2", "piece-3", "piece-4"]
        }
      }
    },
    "mergeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spriteKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "spawnColors": { "type": "integer", "minimum": 2, "maximum": 5, "default": 4 },
        "goalScore": { "type": "integer", "minimum": 1, "default": 300 }
      }
    },
    "pullpinParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "pinsPerLevel": { "type": "integer", "minimum": 3, "maximum": 8, "default": 4 },
        "hazard": { "type": "string", "default": "hazard" },
        "rescuee": { "type": "string", "default": "character" },
        "orderSolution": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "default": []
        }
      }
    },
    "sortParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": { "type": "integer", "minimum": 2, "maximum": 5, "default": 3 },
        "rods": { "type": "integer", "minimum": 3, "maximum": 6, "default": 4 },
        "layersPerRod": { "type": "integer", "minimum": 2, "maximum": 4, "default": 3 },
        "solution": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        }
      }
    }
  }
}
