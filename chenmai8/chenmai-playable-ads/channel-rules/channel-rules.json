{
  "$comment": "渠道规则库（M12 知识资产，packager 配置驱动来源）。结构对应开发指令 §7 表列：包形态/包内结构、大小上限、文件数上限、退出接口、协议、静音要求。本阶段先冻结 applovin/meta/mintegral 三条；unity/google/tiktok 随后续里程碑补齐。数值为行业基线 + 内部从严，D9 官方工具实测后回填修订。",
  "rulesVersion": "1.0.0",
  "updated": "2026-09-28",
  "defaults": {
    "externalUrlPolicy": "forbid",
    "allowedUrlSchemes": ["data:", "blob:"],
    "muteBeforeFirstInteraction": true,
    "allowRelativeRuntimeScripts": true
  },
  "channels": {
    "preview": {
      "label": "Preview",
      "package": {
        "format": "single-html",
        "entry": "index.html",
        "maxFiles": 1
      },
      "maxBytes": 5242880,
      "maxFiles": 1,
      "exit": {
        "protocol": "window-open",
        "call": "window.open(url)",
        "waitReadyBeforeRender": false
      },
      "runtime": {
        "injectRelativeScripts": [],
        "muteBeforeFirstInteraction": true,
        "forbidMraid": false
      },
      "allowedUrlWhitelist": [],
      "source": "本地预览/QC 渠道（非投放渠道）：单 HTML 自包含产物，供 qacore --autoplay 与预览页使用；退出接口回退 window.open。包体上限沿用 5MB 内部从严线。"
    },
    "applovin": {
      "label": "AppLovin",
      "package": {
        "format": "single-html",
        "entry": "index.html",
        "maxFiles": 1
      },
      "maxBytes": 5242880,
      "maxFiles": 1,
      "exit": {
        "protocol": "mraid",
        "call": "mraid.open(url)",
        "waitReadyBeforeRender": true
      },
      "runtime": {
        "injectRelativeScripts": ["mraid.js"],
        "muteBeforeFirstInteraction": true,
        "forbidMraid": false
      },
      "allowedUrlWhitelist": [],
      "source": "单 HTML 全内联，MRAID 2.0，等 ready 再渲染，首交互前静音，禁外链（对照 oRTB 2026 版核实：5MB/单文件/MRAID/静音）。D9 用官方预览工具回填。"
    },
    "meta": {
      "label": "Meta",
      "package": {
        "format": "single-html",
        "entry": "index.html",
        "maxFiles": 1
      },
      "maxBytes": 3145728,
      "maxFiles": 1,
      "exit": {
        "protocol": "fb-playable",
        "call": "FbPlayableAd.onComplete()",
        "waitReadyBeforeRender": false
      },
      "runtime": {
        "injectRelativeScripts": [],
        "muteBeforeFirstInteraction": true,
        "forbidMraid": true
      },
      "allowedUrlWhitelist": [],
      "source": "单 HTML 全内联，退出用 FbPlayableAd.onComplete()，禁 MRAID。大小内部从严 3MB（官方建议 ~2MB，模板侧应再压）。D9 回填。"
    },
    "mintegral": {
      "label": "Mintegral",
      "package": {
        "format": "zip",
        "entry": "Template.html",
        "structure": ["build.js", "Template.html"],
        "maxFiles": 100
      },
      "maxBytes": 5242880,
      "maxFiles": 100,
      "exit": {
        "protocol": "mraid",
        "call": "mraid.open(url)",
        "waitReadyBeforeRender": true
      },
      "runtime": {
        "injectRelativeScripts": ["mraid.js"],
        "muteBeforeFirstInteraction": true,
        "forbidMraid": false
      },
      "allowedUrlWhitelist": [],
      "source": "zip 包，包内为 build.js（游戏逻辑）+ Template.html（入口壳，资源内联）——Phase 0 实测结构。退出接口 mraid.open(url) 在 Template.html 内生效。D9 回填。"
    }
  }
}
